parameters:
	ignoreErrors:
		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 3
			path: src/Console/InstallTenancyCommand.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:domains\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Domains/Tenancy/Actions/ProvisionTenantAction.php

		-
			message: '#^Method CorePanelTenancy\\Domains\\Tenancy\\Actions\\ProvisionTenantAction\:\:normalizeDomains\(\) should return Illuminate\\Support\\Collection\<int, string\> but returns Illuminate\\Support\\Collection\<int, lowercase\-string&non\-falsy\-string\>\.$#'
			identifier: return.type
			count: 1
			path: src/Domains/Tenancy/Actions/ProvisionTenantAction.php

		-
			message: '#^Variable \$tenant in PHPDoc tag @var does not match assigned variable \$tenantAttributes\.$#'
			identifier: varTag.differentVariable
			count: 1
			path: src/Domains/Tenancy/Actions/ProvisionTenantAction.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:domains\(\)\.$#'
