			message: '#^Strict comparison using \!\=\= between class\-string\<Illuminate\\Contracts\\Auth\\Authenticatable&Illuminate\\Database\\Eloquent\\Model\> and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Domains/Tenancy/Actions/UpsertTenantSuperAdminAction.php

