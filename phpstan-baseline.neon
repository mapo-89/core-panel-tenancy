			message: '#^Offset ''is_public'' on array\{type\: string, label\: string, help\: string\|null, default\: mixed, is_public\: bool, is_localized\: bool, options\?\: list\<array\{label\: string, value\: mixed\}\>, rules\: list\<mixed\>\} on left side of \?\? always exists and is not nullable\.$#'
